{
  "name": "tipo-cambio-usd-eur",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --config vite.config.js",
    "dev:server": "node --watch server/src/index.js",
    "start": "node server/src/index.js",
    "test": "vitest run --root .",
    "test:watch": "vitest --root .",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.js",
    "build:server": "node --check server/src/api-error.js && node --check server/src/csv-processor.js && node --check server/src/app.js && node --check server/src/index.js"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "express": "5.1.0",
    "multer": "^2.4.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "concurrently": "9.2.5",
    "jsdom": "^27.0.0",
    "supertest": "^7.1.4",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
